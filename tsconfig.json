{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@battleship/shared": ["./shared/types.ts"],
      "@battleship/shared/*": ["./shared/*"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage"]
}
